{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^workspace_verifier$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/runtime/engine/workspace.mjs\" verifier-hook",
            "commandWindows": "node \"%PLUGIN_ROOT%\\runtime\\engine\\workspace.mjs\" verifier-hook",
            "timeout": 5,
            "statusMessage": "Validating Hypomnema verifier evidence"
          }
        ]
      }
    ]
  }
}
