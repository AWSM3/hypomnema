{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "entity_type": {
      "const": "proposal"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "id": {
      "minLength": 3,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "candidate",
        "accepted",
        "rejected"
      ]
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "target_type",
    "target_id",
    "changes",
    "reason",
    "status",
    "created_at"
  ],
  "type": "object"
}
