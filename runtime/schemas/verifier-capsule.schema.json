{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypomnema.local/schemas/verifier-capsule.schema.json",
  "title": "Hypomnema immutable verifier evidence capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "created_at",
    "workspace",
    "limits",
    "claims",
    "capsule_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "hypomnema-verifier-capsule" },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "canonical_hash", "product_state_sha256"],
      "properties": {
        "root": { "const": "." },
        "canonical_hash": { "$ref": "#/$defs/hash" },
        "product_state_sha256": {
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_claims",
        "max_evidence_entries",
        "max_request_bytes",
        "max_capsule_bytes",
        "max_evidence_file_bytes",
        "max_excerpt_bytes",
        "max_total_excerpt_bytes",
        "max_claim_chars"
      ],
      "properties": {
        "max_claims": { "const": 3 },
        "max_evidence_entries": { "const": 9 },
        "max_request_bytes": { "const": 65536 },
        "max_capsule_bytes": { "const": 65536 },
        "max_evidence_file_bytes": { "const": 2097152 },
        "max_excerpt_bytes": { "const": 2048 },
        "max_total_excerpt_bytes": { "const": 12288 },
        "max_claim_chars": { "const": 1200 }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 3, "maxLength": 128 },
          "claim": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 9,
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    },
    "capsule_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "locator", "sha256", "size_bytes", "excerpt"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 2097152 },
        "excerpt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_line", "end_line", "sha256", "text"],
          "properties": {
            "start_line": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/hash" },
            "text": { "type": "string" }
          }
        }
      }
    }
  }
}
