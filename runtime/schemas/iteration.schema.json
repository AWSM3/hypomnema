{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "entity_type": {
      "const": "iteration"
    },
    "id": {
      "minLength": 3,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "active",
        "closed",
        "cancelled"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "entity_type",
    "work_item",
    "name",
    "goal",
    "status",
    "started_at"
  ],
  "type": "object"
}
