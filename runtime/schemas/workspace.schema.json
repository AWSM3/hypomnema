{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "engine": {
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "greenfield",
        "brownfield"
      ]
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "contract_version",
    "mode",
    "engine"
  ],
  "type": "object"
}
